# Copy this file to .env.cloud on the EC2 host and adjust values there.
# Do not commit .env.cloud.

PYTHONDONTWRITEBYTECODE=1
PYTHONUNBUFFERED=1

# HUD / Legion cockpit
BLACKFONG_HUD_HOST=127.0.0.1
BLACKFONG_HUD_PORT=8080
BLACKFONG_HUD_OPEN_BROWSER=false
BLACKFONG_WINDOWS_TOASTS_ENABLED=false
BLACKFONG_TINYPROGRAMMER_ENABLED=false

# D.A.I.S.E / Ollama backend on the EC2 host.
# The cloud compose file uses host networking, so 127.0.0.1 is the EC2 host.
BLACKFONG_CHAT_BACKEND=ollama
BLACKFONG_OLLAMA_URL=http://127.0.0.1:11434
BLACKFONG_OLLAMA_MODEL=llama3.2:3b
BLACKFONG_FAST_MODEL=llama3.2:1b
BLACKFONG_FAST_MODEL_FALLBACKS=llama3.2:3b
BLACKFONG_STANDARD_MODEL=llama3.2:3b
BLACKFONG_STANDARD_MODEL_FALLBACKS=llama3.2:1b
BLACKFONG_DEEP_MODEL=deepseek-r1:1.5b
BLACKFONG_DEEP_MODEL_FALLBACKS=llama3.2:3b,llama3.2:1b
BLACKFONG_FAST_TIMEOUT=60
BLACKFONG_STANDARD_TIMEOUT=90
BLACKFONG_DEEP_TIMEOUT=180
BLACKFONG_FAST_NUM_CTX=4096
BLACKFONG_STANDARD_NUM_CTX=6144
BLACKFONG_DEEP_NUM_CTX=8192
BLACKFONG_FAST_NUM_PREDICT=256
BLACKFONG_STANDARD_NUM_PREDICT=384
BLACKFONG_DEEP_NUM_PREDICT=512

# Leave tokens blank on first boot; generate/regenerate on the EC2 host.
BLACKFONG_LEGION_PAIRING_TOKEN=
BLACKFONG_SENTINEL_AGENT_TOKEN=

# Private Telegram gateway
BLACKFONG_TELEGRAM_ENABLED=false
BLACKFONG_TELEGRAM_BOT_TOKEN=
# Format: chat_id:user_id,chat_id:user_id
BLACKFONG_TELEGRAM_ALLOWLIST=
BLACKFONG_TELEGRAM_PRIVATE_CHAT_ONLY=true
BLACKFONG_TELEGRAM_POLL_TIMEOUT_SECONDS=20
BLACKFONG_TELEGRAM_POLL_RETRY_DELAY_SECONDS=2
BLACKFONG_TELEGRAM_POLL_LIMIT=20
BLACKFONG_TELEGRAM_REQUEST_TIMEOUT_SECONDS=30
BLACKFONG_TELEGRAM_VOICE_ENABLED=true
BLACKFONG_TELEGRAM_MAX_VOICE_DOWNLOAD_BYTES=10000000
BLACKFONG_TELEGRAM_MAX_VOICE_DURATION_SECONDS=120
BLACKFONG_TELEGRAM_MAX_VOICE_PROCESSING_SECONDS=60
BLACKFONG_TELEGRAM_MAX_TRANSCRIPT_CHARS=4000
