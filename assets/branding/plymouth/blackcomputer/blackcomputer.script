// BLACKCOMPUTER Plymouth Theme
// Asset pack generated for OBEOS / Blackcomputer.
// Lightweight architecture: static background + centered transparent logo animation.

Window.SetBackgroundTopColor(0.0, 0.0, 0.0);
Window.SetBackgroundBottomColor(0.0, 0.0, 0.0);

screen_w = Window.GetWidth();
screen_h = Window.GetHeight();

bg = Image("background.png");
bg_sprite = Sprite(bg);
bg_sprite.SetX((screen_w - bg.GetWidth()) / 2);
bg_sprite.SetY((screen_h - bg.GetHeight()) / 2);
bg_sprite.SetZ(-10);

frames[0] = Image("frames/blackcomputer_000.png");
