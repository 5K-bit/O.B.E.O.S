logo_sprite = Sprite(frames[0]);
logo_sprite.SetX((screen_w - 512) / 2);
logo_sprite.SetY((screen_h / 2) - 366);
logo_sprite.SetZ(10);

frame_index = 0;

fun refresh_callback() {
    frame_index = (frame_index + 1) % 60;
    logo_sprite.SetImage(frames[frame_index]);
}

Plymouth.SetRefreshFunction(refresh_callback);
